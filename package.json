{
  "name": "setup-plastic-scm",
  "version": "2.0.1",
  "description": "A GitHub action to setup and install Plastic SCM (Unity VCS).",
  "author": "RageAgainstThePixel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RageAgainstThePixel/setup-plastic-scm.git"
  },
  "bugs": {
    "url": "https://github.com/RageAgainstThePixel/setup-plastic-scm/issues"
  },
  "homepage": "https://github.com/RageAgainstThePixel/setup-plastic-scm",
  "main": "dist/index.js",
  "keywords": [],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/glob": "^0.7.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "npm run clean && npm run bundle",
    "bundle": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "clean": "npm install && shx rm -rf dist/ out/ node_modules/ && npm ci"
  }
}
